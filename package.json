{
  "name": "smart-cursor-x",
  "private": true,
  "version": "0.0.5-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:native": "npm --prefix native run build",
    "fetch:llama": "powershell -File scripts/download-llama-server.ps1",
    "fetch:llama:full": "powershell -File scripts/download-llama-server.ps1 -All",
    "build": "npm run build:native && tsc && vite build && electron-builder",
    "build:all": "npm run build:native && tsc && vite build && electron-builder -w -m",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:taxonomy": "npx esbuild tests/unit/taxonomy/runTests.ts --bundle --platform=node --format=esm --alias:electron=./tests/unit/taxonomy/electron-mock.js --alias:electron-store=./tests/unit/taxonomy/electron-store-mock.js --outfile=tests/unit/taxonomy/runTests.js && node tests/unit/taxonomy/runTests.js",
    "test:pathguard": "npx esbuild tests/unit/pathGuard/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/pathGuard/runTests.js && node tests/unit/pathGuard/runTests.js",
    "test:pm": "npx esbuild tests/unit/pendingModifications/runTests.ts --bundle --platform=node --format=esm --alias:electron=./tests/unit/taxonomy/electron-mock.js --outfile=tests/unit/pendingModifications/runTests.js && node tests/unit/pendingModifications/runTests.js",
    "test:ipcsec": "npx esbuild tests/unit/ipcSecurity/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/ipcSecurity/runTests.js && node tests/unit/ipcSecurity/runTests.js",
    "test:dlq": "npx esbuild tests/unit/dlq/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/dlq/runTests.js && node tests/unit/dlq/runTests.js",
    "test:dlq:int": "npx esbuild tests/unit/dlq/runIntegration.ts --bundle --platform=node --format=esm --external:@ai-sdk/* --external:ai --external:ollama-ai-provider --external:@vercel/* --external:@opentelemetry/* --alias:electron=./tests/unit/taxonomy/electron-mock.js --alias:electron-store=./tests/unit/taxonomy/electron-store-mock.js --alias:better-sqlite3=./tests/unit/dlq/better-sqlite3-mock.js --outfile=tests/unit/dlq/runIntegration.js && node tests/unit/dlq/runIntegration.js",
    "test:vram": "npx esbuild tests/unit/vramCalculator/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/vramCalculator/runTests.js && node tests/unit/vramCalculator/runTests.js",
    "test:models": "npx esbuild tests/unit/models/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/models/runTests.js && node tests/unit/models/runTests.js",
    "test:scripts": "npx esbuild tests/unit/scriptsArgs/runTests.ts --bundle --platform=node --format=esm --outfile=tests/unit/scriptsArgs/runTests.js && node tests/unit/scriptsArgs/runTests.js",
    "test:changes": "npx esbuild tests/unit/changes/runTests.ts --bundle --platform=node --format=esm --alias:electron=./tests/unit/taxonomy/electron-mock.js --alias:electron-store=./tests/unit/taxonomy/electron-store-mock.js --outfile=tests/unit/changes/runTests.js && node tests/unit/changes/runTests.js",
    "test:planning": "npx esbuild tests/unit/planning/runTests.ts --bundle --platform=node --format=esm --external:@ai-sdk/* --external:ai --external:ollama-ai-provider --external:@vercel/* --external:@opentelemetry/* --alias:electron=./tests/unit/taxonomy/electron-mock.js --alias:electron-store=./tests/unit/taxonomy/electron-store-mock.js --outfile=tests/unit/planning/runTests.js && node tests/unit/planning/runTests.js",
    "test": "npm run test:pathguard && npm run test:pm && npm run test:ipcsec && npm run test:dlq && npm run test:dlq:int && npm run test:changes && npm run test:planning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@monaco-editor/react": "^4.6.0",
    "@vscode/codicons": "^0.0.44",
    "@xterm/addon-fit": "^0.11.0",
    "ai": "^6.0.200",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "diff": "^9.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.1.8",
    "esbuild": "^0.28.1",
    "framer-motion": "^11.0.0",
    "monaco-vim": "^0.4.1",
    "node-pty": "^1.1.0",
    "ollama-ai-provider": "^1.2.0",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.4.1",
    "reactflow": "^11.11.4",
    "sqlite-vec": "^0.1.9",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "monaco-editor": "^0.55.1",
    "typescript": "^5.2.2",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3"
  },
  "main": "dist-electron/main.js"
}
